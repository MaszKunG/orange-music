# ==========================================
# 🍊 Orange Music Backend Configuration
# ==========================================

PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# ------------------------------------------
# 1. โหมดฐานข้อมูล (Database)
# ------------------------------------------
# ก) โหมด Local (ค่าเริ่มต้น): ใช้ SQLite ในเครื่อง
DB_PATH=./database.sqlite

# ข) โหมด Cloud Production (ฟรีจาก Turso - LibSQL):
# แนะนำสำหรับ Deploy บน Render.com (ไม่สูญหายเมื่อรีสตาร์ท)
# สมัครฟรีที่ https://turso.tech (ได้ฟรี 9GB)
# TURSO_DATABASE_URL=libsql://your-database-name-username.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------
# 2. โหมดพื้นที่เก็บไฟล์ (File Storage - R2)
# ------------------------------------------
# ค่าเริ่มต้น: บันทึกลงโฟลเดอร์ uploads/ ในเครื่อง
# สำหรับ Production บน Render: แนะนำ Cloudflare R2 (ฟรี 10GB ไม่คิดค่า egress/bandwidth)
# สมัครฟรีที่ https://dash.cloudflare.com/
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=orange-music
# R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
